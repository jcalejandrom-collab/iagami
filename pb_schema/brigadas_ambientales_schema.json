[
  {
    "name": "representantes_legales",
    "type": "base",
    "system": false,
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": null,
    "schema": [
      {"name": "nombres",         "type": "text",   "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "apellidos",       "type": "text",   "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "cedula",          "type": "text",   "required": true,  "options": {"min": 6, "max": 12}},
      {"name": "parentesco",      "type": "select", "required": true,  "options": {"values": ["Padre","Madre","Tutor Legal","Abuelo/a","Otro"]}},
      {"name": "telefono",        "type": "text",   "required": true,  "options": {"min": 7, "max": 15}},
      {"name": "telefono_alt",    "type": "text",   "required": false, "options": {"min": 7, "max": 15}},
      {"name": "correo",          "type": "email",  "required": false},
      {"name": "direccion",       "type": "text",   "required": true,  "options": {"min": 5, "max": 300}},
      {"name": "parroquia",       "type": "select", "required": true,  "options": {"values": ["Catedral","Concepción","El Cuji","Juan de Villegas","Tamaca","Unión","Agua Viva","Buena Vista","Cabudare","Montalbán","Olivos","Santa Rosa","Río Claro","Juárez","Aguedo Felipe Alvarado","Sarare"]}},
      {"name": "comunidad",       "type": "text",   "required": true,  "options": {"min": 2, "max": 150}},
      {"name": "created",         "type": "autodate","onCreate": true,  "onUpdate": false}
    ]
  },
  {
    "name": "brigadistas",
    "type": "base",
    "system": false,
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": null,
    "schema": [
      {"name": "nombres",           "type": "text",     "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "apellidos",         "type": "text",     "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "cedula",            "type": "text",     "required": true,  "options": {"min": 6, "max": 12}},
      {"name": "fecha_nacimiento",  "type": "text",     "required": true},
      {"name": "genero",            "type": "select",   "required": true,  "options": {"values": ["Masculino","Femenino","Prefiero no indicar"]}},
      {"name": "telefono",          "type": "text",     "required": true,  "options": {"min": 7, "max": 15}},
      {"name": "correo",            "type": "email",    "required": false},
      {"name": "parroquia",         "type": "select",   "required": true,  "options": {"values": ["Catedral","Concepción","El Cuji","Juan de Villegas","Tamaca","Unión","Agua Viva","Buena Vista","Cabudare","Montalbán","Olivos","Santa Rosa","Río Claro","Juárez","Aguedo Felipe Alvarado","Sarare"]}},
      {"name": "comunidad",         "type": "text",     "required": true,  "options": {"min": 2, "max": 150}},
      {"name": "areas_interes",     "type": "json",     "required": false},
      {"name": "disponibilidad",    "type": "select",   "required": true,  "options": {"values": ["Fines de semana","Entre semana","Ambos","Tiempo completo"]}},
      {"name": "experiencia",       "type": "text",     "required": false, "options": {"max": 500}},
      {"name": "estado",            "type": "select",   "required": true,  "options": {"values": ["pendiente","activo","inactivo"]}, "default": "pendiente"},
      {"name": "created",           "type": "autodate", "onCreate": true,  "onUpdate": false}
    ]
  },
  {
    "name": "brigadistas_menores",
    "type": "base",
    "system": false,
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": null,
    "schema": [
      {"name": "nombres",              "type": "text",     "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "apellidos",            "type": "text",     "required": true,  "options": {"min": 2, "max": 100}},
      {"name": "fecha_nacimiento",     "type": "text",     "required": true},
      {"name": "edad",                 "type": "number",   "required": true},
      {"name": "categoria",            "type": "select",   "required": true,  "options": {"values": ["adolescente","nino"]}},
      {"name": "genero",               "type": "select",   "required": true,  "options": {"values": ["Masculino","Femenino","Prefiero no indicar"]}},
      {"name": "institucion_educativa","type": "text",     "required": true,  "options": {"min": 2, "max": 200}},
      {"name": "grado",                "type": "text",     "required": false, "options": {"max": 50}},
      {"name": "parroquia",            "type": "select",   "required": true,  "options": {"values": ["Catedral","Concepción","El Cuji","Juan de Villegas","Tamaca","Unión","Agua Viva","Buena Vista","Cabudare","Montalbán","Olivos","Santa Rosa","Río Claro","Juárez","Aguedo Felipe Alvarado","Sarare"]}},
      {"name": "comunidad",            "type": "text",     "required": true,  "options": {"min": 2, "max": 150}},
      {"name": "areas_interes",        "type": "json",     "required": false},
      {"name": "representante",        "type": "relation", "required": true,  "options": {"collectionId": "representantes_legales", "cascadeDelete": false, "maxSelect": 1, "minSelect": 1}},
      {"name": "estado",               "type": "select",   "required": true,  "options": {"values": ["pendiente_consentimiento","consentimiento_cargado","en_revision","aprobado","rechazado","retirado"]}, "default": "pendiente_consentimiento"},
      {"name": "created",              "type": "autodate", "onCreate": true,  "onUpdate": false}
    ]
  },
  {
    "name": "consentimientos",
    "type": "base",
    "system": false,
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": null,
    "schema": [
      {"name": "menor",              "type": "relation", "required": true,  "options": {"collectionId": "brigadistas_menores", "cascadeDelete": false, "maxSelect": 1, "minSelect": 1}},
      {"name": "representante",      "type": "relation", "required": true,  "options": {"collectionId": "representantes_legales", "cascadeDelete": false, "maxSelect": 1, "minSelect": 1}},
      {"name": "documento",          "type": "file",     "required": false, "options": {"maxSelect": 1, "maxSize": 10485760, "mimeTypes": ["application/pdf","image/jpeg","image/png"]}},
      {"name": "autoriza_fotos",     "type": "bool",     "required": false},
      {"name": "estado",             "type": "select",   "required": true,  "options": {"values": ["pendiente","cargado","en_revision","requiere_correccion","aprobado","rechazado","retirado"]}, "default": "pendiente"},
      {"name": "observaciones",      "type": "text",     "required": false, "options": {"max": 500}},
      {"name": "revisado_por",       "type": "text",     "required": false, "options": {"max": 100}},
      {"name": "fecha_revision",     "type": "text",     "required": false},
      {"name": "created",            "type": "autodate", "onCreate": true,  "onUpdate": false}
    ]
  }
]
